---
import BaseLayout from "../layouts/BaseLayout.astro";
import { useTranslations } from "../i18n/utils";

const lang = "es";
const t = useTranslations(lang);
---

<BaseLayout title="404 | c0l1nr00t" description={t("404.desc")}>
    <div class="container section wrap">
        <div class="terminal">
            <div class="terminal-bar">
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="terminal-title">error.log</span>
            </div>
            <div class="terminal-body">
                <p class="line">
                    <span class="prompt">➜</span> cat {Astro.url.pathname}
                </p>
                <p class="err">404: ROUTE_NOT_FOUND</p>
                <p class="out">{t("404.desc")}</p>
                <p class="line">
                    <span class="prompt">➜</span>
                    <span class="caret"></span>
                </p>
            </div>
        </div>

        <a href={`/${lang}`} class="btn btn-primary">
            <span aria-hidden="true">←</span>
            {t("404.back")}
        </a>
    </div>
</BaseLayout>

<style>
    .wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--sp-7);
        text-align: center;
    }

    .terminal {
        width: 100%;
        max-width: 34rem;
        text-align: left;
    }

    .line {
        margin: 0;
        color: var(--text-strong);
    }

    .line .prompt {
        margin-right: var(--sp-2);
    }

    .err {
        margin: var(--sp-2) 0;
        padding-left: 1.25rem;
        color: var(--danger);
        letter-spacing: var(--tracking-wide);
    }

    .out {
        margin: 0 0 var(--sp-4);
        padding-left: 1.25rem;
        color: var(--text-dim);
    }
</style>
