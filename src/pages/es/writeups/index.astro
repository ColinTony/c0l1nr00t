---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Card from "../../../components/Card.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../../i18n/utils";

const lang = "es";
const t = useTranslations(lang);

const writeups = await getCollection("writeups", ({ id, data }) => {
    return (
        id.startsWith("es/") &&
        data.status !== "draft" &&
        data.visible !== false
    );
});

const sortedWriteups = writeups.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const platforms = [...new Set(writeups.map((w) => w.data.platform))].sort();
const difficulties = ["easy", "medium", "hard", "insane", "n/a"].filter((d) =>
    writeups.some((w) => w.data.difficulty === d),
);
const categories = [...new Set(writeups.map((w) => w.data.category))].sort();

const filters = [
    { id: "platform", label: t("meta.platform"), options: platforms },
    { id: "difficulty", label: t("meta.difficulty"), options: difficulties },
    { id: "category", label: t("meta.category"), options: categories },
];
---

<BaseLayout
    title={`c0l1nr00t | ${t("nav.writeups")}`}
    description="Writeups de máquinas, programas de bug bounty y research aplicado."
>
    <div class="container section">
        <header class="page-header">
            <p class="eyebrow">&gt; ~/writeups</p>
            <h1>{t("nav.writeups")}</h1>
            <p class="lead">
                Writeups técnicos completos: cadenas reproducibles, evidencia y
                lecciones. Solo lo que ejecuté y puedo explicar, y solo cuando
                la divulgación coordinada lo permite.
            </p>
        </header>

        {
            sortedWriteups.length === 0 ? (
                <div class="empty-wrap">
                    <p class="empty-state">
                        <strong>{t("writeups.count").toUpperCase()}: 0</strong>
                        {t("writeups.empty")}
                    </p>
                    <a href={`/${lang}/research`} class="btn btn-primary">
                        $ ver research
                    </a>
                </div>
            ) : (
                <>
                    <form class="filters" id="writeup-filters">
                        {filters.map((filter) => (
                            <div class="field">
                                <label for={`${filter.id}-filter`}>
                                    {filter.label}
                                </label>
                                <select
                                    id={`${filter.id}-filter`}
                                    class="select"
                                    data-filter={filter.id}
                                >
                                    <option value="all">
                                        {t("writeups.all")}
                                    </option>
                                    {filter.options.map((option) => (
                                        <option value={option}>{option}</option>
                                    ))}
                                </select>
                            </div>
                        ))}

                        <div class="filters-actions">
                            <span class="result-count mono" id="result-count">
                                {sortedWriteups.length} {t("writeups.count")}
                            </span>
                            <button
                                type="reset"
                                class="btn btn-ghost btn-sm"
                                id="reset-filters"
                            >
                                {t("writeups.reset")}
                            </button>
                        </div>
                    </form>

                    <div class="grid-cards" id="writeups-grid">
                        {sortedWriteups.map((post) => (
                            <div
                                class="writeup-item"
                                data-platform={post.data.platform}
                                data-difficulty={post.data.difficulty}
                                data-category={post.data.category}
                            >
                                <Card
                                    href={`/${lang}/writeups/${post.slug.split("/")[1]}`}
                                    title={post.data.title}
                                    date={post.data.date}
                                    description={post.data.description}
                                    difficulty={post.data.difficulty}
                                    platform={post.data.platform}
                                    tags={post.data.tags}
                                />
                            </div>
                        ))}
                    </div>

                    <p class="empty-state is-hidden" id="no-results">
                        {t("writeups.no_results")}
                    </p>
                </>
            )
        }
    </div>
</BaseLayout>

<script>
    function setupFilters() {
        const form = document.getElementById(
            "writeup-filters",
        ) as HTMLFormElement | null;
        if (!form) return;

        const selects = Array.from(
            form.querySelectorAll<HTMLSelectElement>("select[data-filter]"),
        );
        const items =
            document.querySelectorAll<HTMLElement>(".writeup-item");
        const noResults = document.getElementById("no-results");
        const counter = document.getElementById("result-count");
        const countLabel = counter?.textContent?.replace(/^\d+\s*/, "") ?? "";

        const apply = () => {
            let visible = 0;

            items.forEach((item) => {
                const match = selects.every((select) => {
                    const key = select.dataset.filter ?? "";
                    return (
                        select.value === "all" ||
                        select.value === item.dataset[key]
                    );
                });

                item.hidden = !match;
                if (match) visible++;
            });

            noResults?.classList.toggle("is-hidden", visible > 0);
            if (counter) counter.textContent = `${visible} ${countLabel}`;
        };

        selects.forEach((select) => select.addEventListener("change", apply));
        form.addEventListener("reset", () => window.requestAnimationFrame(apply));
    }

    setupFilters();
    document.addEventListener("astro:page-load", setupFilters);
</script>

<style>
    .filters {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: var(--sp-4);
        margin-bottom: var(--sp-7);
        padding: var(--sp-4) var(--sp-5);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
    }

    .filters-actions {
        display: flex;
        align-items: center;
        gap: var(--sp-4);
        margin-left: auto;
    }

    .result-count {
        color: var(--text-faint);
        font-size: var(--fs-xs);
        letter-spacing: var(--tracking-wide);
    }

    .empty-state {
        margin: 0;
    }

    .empty-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--sp-5);
    }

    .empty-wrap .empty-state {
        width: 100%;
    }

    .is-hidden {
        display: none;
    }

    #no-results {
        margin-top: var(--sp-6);
    }

    @media (max-width: 700px) {
        .filters {
            flex-direction: column;
            align-items: stretch;
        }

        .filters-actions {
            margin-left: 0;
            justify-content: space-between;
        }
    }
</style>
