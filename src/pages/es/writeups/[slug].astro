---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Reactions from "../../../components/Reactions.astro";
import { useTranslations } from "../../../i18n/utils";

export async function getStaticPaths() {
    const posts = await getCollection("writeups");
    const esPosts = posts.filter(
        (post) =>
            post.id.startsWith("es/") &&
            post.data.status !== "draft" &&
            post.data.visible !== false,
    );
    return esPosts.map((post) => ({
        params: { slug: post.slug.split("/")[1] },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const lang = "es";
const t = useTranslations(lang);

const isoDate = post.data.date.toISOString().split("T")[0];

const meta = [
    { label: t("meta.platform"), value: post.data.platform },
    { label: t("meta.category"), value: post.data.category },
    { label: t("meta.date"), value: isoDate },
    post.data.target && { label: t("meta.target"), value: post.data.target },
    post.data.program && { label: "Program", value: post.data.program },
].filter(Boolean);
---

<BaseLayout
    title={`${post.data.title} | c0l1nr00t`}
    description={post.data.description}
    type="article"
    publishedDate={post.data.date}
    tags={post.data.tags}
>
    <div class="container section">
        <a href={`/${lang}/writeups`} class="back-link">
            <span aria-hidden="true">←</span>
            {t("writeups.back")}
        </a>

        <article class="article">
            <header class="post-header">
                <p class="post-meta mono">
                    <span class="platform">{post.data.platform}</span>
                    <span class="sep" aria-hidden="true">/</span>
                    <span class={`difficulty ${post.data.difficulty}`}>
                        {post.data.difficulty}
                    </span>
                    {
                        post.data.status === "retired" && (
                            <span class="chip">{t("badge.retired")}</span>
                        )
                    }
                </p>

                <h1>{post.data.title}</h1>
                <p class="lead">{post.data.description}</p>

                {
                    post.data.redacted && (
                        <p class="notice mono">
                            <span aria-hidden="true">⚠</span>
                            {t("msg.redacted")}
                        </p>
                    )
                }

                <dl class="meta-grid mono">
                    {
                        meta.map((item) => (
                            <div class="meta-item">
                                <dt>{item.label}</dt>
                                <dd>{item.value}</dd>
                            </div>
                        ))
                    }
                </dl>

                {
                    post.data.tags.length > 0 && (
                        <p class="tags">
                            {post.data.tags.map((tag) => (
                                <span class="chip">#{tag}</span>
                            ))}
                        </p>
                    )
                }
            </header>

            <div class="prose">
                <Content />
            </div>
        </article>

        <Reactions entry={`/${lang}/writeups/${post.slug.split("/")[1]}`} />
    </div>
</BaseLayout>

<style>
    .article {
        margin-top: var(--sp-6);
    }

    .post-header {
        max-width: var(--measure);
        margin-bottom: var(--sp-8);
        padding-bottom: var(--sp-6);
        border-bottom: 1px solid var(--border);
    }

    .post-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--sp-3);
        margin-bottom: var(--sp-4);
        font-size: var(--fs-xs);
        letter-spacing: var(--tracking-wide);
    }

    .platform {
        color: var(--accent);
        text-transform: uppercase;
    }

    .sep {
        color: var(--border-strong);
    }

    .post-header h1 {
        margin-bottom: var(--sp-4);
        text-wrap: pretty;
    }

    .lead {
        margin-bottom: var(--sp-5);
        color: var(--text-dim);
        font-size: var(--fs-lg);
    }

    .notice {
        display: flex;
        align-items: center;
        gap: var(--sp-3);
        margin-bottom: var(--sp-5);
        padding: var(--sp-3) var(--sp-4);
        background: color-mix(in srgb, var(--warn) 10%, transparent);
        border: 1px solid color-mix(in srgb, var(--warn) 40%, transparent);
        border-radius: var(--radius-sm);
        color: var(--warn);
        font-size: var(--fs-sm);
    }

    .meta-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
        gap: var(--sp-4);
        margin: 0 0 var(--sp-5);
        padding: var(--sp-4) var(--sp-5);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
    }

    .meta-item dt {
        margin-bottom: var(--sp-1);
        color: var(--text-faint);
        font-size: var(--fs-xs);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
    }

    .meta-item dd {
        margin: 0;
        color: var(--text-strong);
        font-size: var(--fs-sm);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--sp-2);
        margin: 0;
    }
</style>
