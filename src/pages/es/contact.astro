---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations } from "../../i18n/utils";
import "../../styles/pages/contact.css";

const lang = "es";
const t = useTranslations(lang);

const FORM_ID = "8536b0703e1d3d2ab083844c5c53bef3";

const protocols = [
    {
        value: "mentoria",
        code: "01_MENTORSHIP",
        target: "KNOWLEDGE",
        tone: "accent",
        desc: "Clases 1:1 de Hacking Web, Bug Bounty o Reversing. Ruta personalizada, sin relleno.",
    },
    {
        value: "pentest",
        code: "02_PENTEST",
        target: "SECURITY",
        tone: "warn",
        desc: "Auditoría de seguridad para tu empresa o producto. Reportes accionables, impacto real.",
    },
    {
        value: "collab",
        code: "03_COLLAB",
        target: "COMMUNITY",
        tone: "link",
        desc: "Charlas, streams, research conjunto o proyectos open source.",
    },
    {
        value: "social",
        code: "04_SOCIAL",
        target: "NETWORK",
        tone: "purple",
        desc: "Solo platicar, networking o preguntas random. No seas tímido.",
    },
];

const socials = [
    { href: "https://github.com/ColinTony", label: "GitHub" },
    { href: "https://www.linkedin.com/in/luisantoniocolin/", label: "LinkedIn" },
    { href: "https://x.com/c0l1nr00t", label: "X / Twitter" },
];
---

<BaseLayout
    title={`c0l1nr00t | ${t("nav.contact")}`}
    description="Clases 1:1, pentest y colaboraciones."
    image="/og/contact.png"
>
    <div class="container container-narrow section">
        <header class="page-header contact-header">
            <p class="eyebrow">&gt; ./contact --init</p>
            <h1>{t("contact.title")}</h1>
            <p class="lead">
                Selecciona un <strong>protocolo</strong> para iniciar la
                comunicación. Sé directo y conciso.
            </p>
        </header>

        <div class="panel console">
            <div class="panel-header">
                <span>message_buffer.sh</span>
                <span class="dots" aria-hidden="true">
                    <span class="dot"></span>
                    <span class="dot"></span>
                    <span class="dot is-live"></span>
                </span>
            </div>

            <div class="panel-content">
                <div id="form-container" class="console-grid">
                    <fieldset class="protocols">
                        <legend class="mono">Select protocol</legend>

                        <div class="protocol-list">
                            {
                                protocols.map((protocol, i) => (
                                    <label class="protocol">
                                        <input
                                            type="radio"
                                            name="protocol"
                                            value={protocol.value}
                                            checked={i === 0}
                                        />
                                        <span class="mono">{protocol.code}</span>
                                    </label>
                                ))
                            }
                        </div>

                        <div class="protocol-details">
                            {
                                protocols.map((protocol, i) => (
                                    <div
                                        id={`info-${protocol.value}`}
                                        class={`info ${i === 0 ? "active" : ""}`}
                                    >
                                        <p class={`info-target mono is-${protocol.tone}`}>
                                            &gt; target: {protocol.target}
                                        </p>
                                        <p class="info-desc">{protocol.desc}</p>
                                    </div>
                                ))
                            }
                        </div>
                    </fieldset>

                    <form
                        id="contact-form"
                        action={`https://formsubmit.co/${FORM_ID}`}
                        method="POST"
                        class="console-form"
                    >
                        <input
                            type="hidden"
                            name="_subject"
                            value="Nuevo Contacto de c0l1nr00t (ES)"
                        />
                        <input type="hidden" name="_template" value="table" />
                        <input type="hidden" name="_captcha" value="false" />
                        <input
                            type="hidden"
                            id="topic"
                            name="topic"
                            value="mentoria"
                        />

                        <div class="console-line">
                            <span class="prompt mono" aria-hidden="true">$</span>
                            <label class="visually-hidden" for="name">
                                {t("contact.form.name")}
                            </label>
                            <input
                                type="text"
                                id="name"
                                name="name"
                                placeholder="whoami — tu nombre"
                                required
                                autocomplete="name"
                            />
                        </div>

                        <div class="console-line">
                            <span class="prompt mono" aria-hidden="true">$</span>
                            <label class="visually-hidden" for="email">
                                {t("contact.form.email")}
                            </label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="mail — tu email"
                                required
                                autocomplete="email"
                            />
                        </div>

                        <div class="console-block">
                            <span class="prompt mono" aria-hidden="true">$</span>
                            <label class="visually-hidden" for="message">
                                {t("contact.form.message")}
                            </label>
                            <textarea
                                id="message"
                                name="message"
                                rows="7"
                                required
                                placeholder="echo 'tu mensaje aquí...'"></textarea>
                        </div>

                        <p class="form-error mono" id="form-error" hidden>
                            No se pudo enviar. Intenta de nuevo o escríbeme por
                            redes.
                        </p>

                        <div class="console-actions">
                            <button type="submit" class="btn btn-primary">
                                &gt; {t("contact.form.send")}
                            </button>
                        </div>
                    </form>
                </div>

                <div id="success-message" class="success" hidden>
                    <span class="success-icon mono" aria-hidden="true">✓</span>
                    <p class="success-title mono">status: 200 OK</p>
                    <p class="success-desc">
                        {t("contact.form.success")} Te respondo en cuanto lo lea.
                    </p>
                    <a href={`/${lang}`} class="btn btn-outline">
                        &gt; return_to_root
                    </a>
                </div>
            </div>
        </div>

        <section class="socials">
            <p class="mono">{t("contact.social")}</p>
            <div class="social-list">
                {
                    socials.map((social) => (
                        <a
                            class="chip"
                            href={social.href}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {social.label}
                        </a>
                    ))
                }
            </div>
        </section>
    </div>
</BaseLayout>

<script>
    function setupContact() {
        const form = document.getElementById(
            "contact-form",
        ) as HTMLFormElement | null;
        if (!form) return;

        const topic = document.getElementById("topic") as HTMLInputElement;
        const infos = document.querySelectorAll(".info");
        const errorBox = document.getElementById("form-error");
        const success = document.getElementById("success-message");
        const container = document.getElementById("form-container");
        const action = form.action.replace(
            "formsubmit.co/",
            "formsubmit.co/ajax/",
        );

        document
            .querySelectorAll<HTMLInputElement>('input[name="protocol"]')
            .forEach((radio) => {
                radio.addEventListener("change", () => {
                    if (topic) topic.value = radio.value;
                    infos.forEach((info) => info.classList.remove("active"));
                    document
                        .getElementById(`info-${radio.value}`)
                        ?.classList.add("active");
                });
            });

        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const btn = form.querySelector(
                'button[type="submit"]',
            ) as HTMLButtonElement | null;
            const label = btn?.textContent ?? "";

            if (btn) {
                btn.disabled = true;
                btn.textContent = "> enviando...";
            }
            if (errorBox) errorBox.hidden = true;

            try {
                const res = await fetch(action, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        Accept: "application/json",
                    },
                    body: JSON.stringify(
                        Object.fromEntries(new FormData(form)),
                    ),
                });

                if (!res.ok) throw new Error(`HTTP ${res.status}`);

                if (container) container.hidden = true;
                if (success) success.hidden = false;
            } catch (error) {
                console.error(error);
                if (errorBox) errorBox.hidden = false;
                if (btn) {
                    btn.disabled = false;
                    btn.textContent = label;
                }
            }
        });
    }

    setupContact();
    document.addEventListener("astro:page-load", setupContact);
</script>
