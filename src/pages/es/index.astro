---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRow from "../../components/PostRow.astro";
import Terminal from "../../components/Terminal.astro";
import Standing from "../../components/Standing.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../i18n/utils";
import { readingTime } from "../../utils/reading-time";
import {
    identity,
    researchAreas,
    statusLabels,
    researchLog,
    stats,
    methodology,
} from "../../data/research";

const lang = "es";
const t = useTranslations(lang);

const posts = await getCollection("blog", ({ id, data }) => {
    return id.startsWith("es/") && !data.draft && data.visible !== false;
});

const sortedPosts = posts
    .sort((a, b) => {
        if (a.data.pinned && !b.data.pinned) return -1;
        if (!a.data.pinned && b.data.pinned) return 1;
        return b.data.date.valueOf() - a.data.date.valueOf();
    })
    .slice(0, 4);
---

<BaseLayout
    title={`${identity.handle} | ${identity.role}`}
    description={`${identity.role} mexicano. ${identity.lead}`}
    image="/og/home.png"
>
    <section class="hero">
        <div class="container hero-inner">
            <div class="hero-copy">
                <p class="eyebrow">
                    &gt; {identity.handle} · {identity.role}
                </p>
                <h1 data-scramble>{identity.tagline}</h1>
                <p class="lead">{identity.lead}</p>

                <div class="ctas">
                    <a href={`/${lang}/research`} class="btn btn-primary">
                        {t("cta.research")}
                    </a>
                    <a href={`/${lang}/about`} class="btn btn-outline">
                        {t("cta.about")}
                    </a>
                </div>

                <p class="hint mono">
                    <button type="button" class="hint-btn" data-palette-open>
                        <span class="kbd">Ctrl</span><span class="kbd">K</span>
                    </button>
                    para saltar a cualquier sección · o escribe
                    <code>help</code> en la terminal
                </p>
            </div>

            <Terminal />
        </div>
    </section>

    <section class="band" aria-label="Trayectoria">
        <div class="container">
            <div class="stats">
                {
                    stats.map((stat) => (
                        <div class="stat">
                            <span class="stat-value" data-count>
                                {stat.value}
                            </span>
                            <span class="stat-label">{stat.label}</span>
                        </div>
                    ))
                }
                <Standing variant="stat" />
            </div>
        </div>
    </section>

    <section class="container section">
        <h2 class="section-title">{t("section.currently_researching")}</h2>

        <ul class="areas">
            {
                researchAreas.map((area, i) => (
                    <li
                        class="area"
                        data-spotlight
                        data-reveal
                        style={`--reveal-delay:${i * 45}ms`}
                    >
                        <div class="area-head">
                            <h3>{area.title}</h3>
                            <span class={`status is-${area.status}`}>
                                {statusLabels[area.status]}
                            </span>
                        </div>
                        <p>{area.summary}</p>
                    </li>
                ))
            }
        </ul>
    </section>

    <section class="band band-lg">
        <div class="container">
        <div class="section-head">
            <h2 class="section-title">{t("section.research_log")}</h2>
            <Standing />
        </div>

        <ol class="log">
            {
                researchLog.map((item, i) => (
                    <li
                        class="log-item"
                        data-spotlight
                        data-reveal
                        style={`--reveal-delay:${i * 60}ms`}
                    >
                        <span class="log-mark" aria-hidden="true" />
                        <p class="log-entry">{item.entry}</p>
                        <p class="log-meta mono">
                            <span class="platform">{item.platform}</span>
                            <span
                                class="log-status"
                                data-status={item.status}
                            >
                                {item.status}
                            </span>
                        </p>
                    </li>
                ))
            }
        </ol>

        <p class="disclosure mono">{t("research.disclosure")}</p>
        </div>
    </section>

    <section class="container section-sm">
        <a href={`/${lang}/research#methodology`} class="loop-band" data-reveal>
            <div class="loop-band-copy">
                <p class="loop-kicker mono">How I work</p>
                <h2 class="loop-title">
                    Casi toda mi investigación empieza por preguntas, no por
                    herramientas.
                </h2>
                <p class="loop-desc">
                    Un scanner te dice qué responde; las preguntas te dicen
                    dónde mirar.
                </p>
            </div>

            <ol class="loop mono" aria-hidden="true">
                {
                    methodology.loop.map((step, i) => (
                        <li style={`--i:${i}`}>
                            <span>{step}</span>
                        </li>
                    ))
                }
            </ol>
        </a>
    </section>

    <section class="container section-sm">
        <h2 class="section-title">{t("section.latest_posts")}</h2>

        <div class="rows">
            {
                sortedPosts.map((post) => (
                    <PostRow
                        href={`/${lang}/blog/${post.slug.split("/")[1]}`}
                        title={post.data.title}
                        date={post.data.date}
                        description={post.data.description}
                        category={post.data.category}
                        type={post.data.type}
                        tags={post.data.tags}
                        readingTime={readingTime(post.body, t("blog.read_time"))}
                        pinned={post.data.pinned}
                    />
                ))
            }
        </div>

        <a href={`/${lang}/blog`} class="view-all mono">
            {t("section.view_all")} <span aria-hidden="true">→</span>
        </a>
    </section>
</BaseLayout>

<style>
    /* --- Hero ---------------------------------------------------------- */
    .hero {
        padding-block: clamp(3rem, 8vw, 5.5rem);
        border-bottom: 1px solid var(--border);
    }

    .hero-inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
        align-items: center;
        gap: clamp(2rem, 5vw, 4rem);
    }

    .hero-copy h1 {
        max-width: 18ch;
        margin-bottom: var(--sp-5);
        font-size: clamp(1.75rem, 1.2rem + 2.4vw, 3rem);
        text-wrap: pretty;
    }

    .lead {
        max-width: 48ch;
        margin-bottom: var(--sp-6);
        color: var(--text-dim);
        font-size: var(--fs-lg);
    }

    .ctas {
        display: flex;
        flex-wrap: wrap;
        gap: var(--sp-3);
    }

    .hint {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem;
        margin: var(--sp-5) 0 0;
        color: var(--text-faint);
        font-size: var(--fs-xs);
    }

    .hint-btn {
        display: inline-flex;
        gap: 3px;
        padding: 0;
        background: none;
        border: 0;
        cursor: pointer;
    }

    .hint code {
        background: var(--surface-2);
        color: var(--text-dim);
    }

    /* --- Currently researching ----------------------------------------- */
    .areas {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
        gap: 1px;
        margin: 0;
        padding: 0;
        list-style: none;
        background: var(--border);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
    }

    .area {
        padding: var(--sp-5);
        background: var(--surface);
        transition: background-color var(--dur) var(--ease);
    }

    .area:hover {
        background: var(--surface-2);
    }

    .area-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--sp-3);
        margin-bottom: var(--sp-2);
    }

    .area h3 {
        margin: 0;
        font-size: var(--fs-md);
        color: var(--text-strong);
    }

    .area p {
        margin: 0;
        color: var(--text-dim);
        font-size: var(--fs-base);
        line-height: var(--lh-snug);
    }

    .status {
        flex-shrink: 0;
        font-family: var(--font-mono);
        font-size: var(--fs-xs);
        color: var(--text-faint);
        letter-spacing: var(--tracking-wide);
    }

    .status.is-active {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--accent);
    }

    /* Latido solo en lo que está en curso */
    .status.is-active::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent);
        animation: pulse 2.4s var(--ease) infinite;
    }

    @keyframes pulse {
        0%,
        100% {
            opacity: 1;
            box-shadow: 0 0 0 0 var(--accent-soft);
        }
        50% {
            opacity: 0.55;
            box-shadow: 0 0 0 4px transparent;
        }
    }

    /* --- Bandas a ancho completo ---------------------------------------- */
    /* Rompen la sucesión de secciones sobre el mismo fondo: la página deja de
       ser una lista de tarjetas y pasa a tener ritmo. */
    .band {
        padding-block: var(--sp-7);
        background: var(--bg-soft);
        border-bottom: 1px solid var(--border);
    }

    .band-lg {
        padding-block: var(--sp-9);
    }

    /* --- Research log --------------------------------------------------- */
    /* El título trae su propia línea de continuación, así que la credencial
       se cuelga al final de esa línea en vez de dentro del encabezado. */
    .section-head {
        display: flex;
        align-items: center;
        gap: var(--sp-4);
        margin-bottom: var(--sp-6);
    }

    .section-head .section-title {
        flex: 1;
        min-width: 0;
        margin-bottom: 0;
    }

    .log {
        margin: 0;
        padding: 0 0 0 var(--sp-5);
        border-left: 1px solid var(--border);
        list-style: none;
    }

    .log-item {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: var(--sp-3) var(--sp-5);
        padding: var(--sp-4) var(--sp-5);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        transition:
            border-color var(--dur) var(--ease),
            transform var(--dur) var(--ease);
    }

    .log-item + .log-item {
        margin-top: var(--sp-3);
    }

    .log-item:hover {
        border-color: var(--border-strong);
        transform: translateX(2px);
    }

    /* El punto se apoya sobre la línea vertical de la lista */
    .log-mark {
        position: absolute;
        top: 50%;
        left: calc(var(--sp-5) * -1 - 4px);
        width: 7px;
        height: 7px;
        background: var(--bg);
        border: 1px solid var(--border-strong);
        border-radius: 50%;
        transform: translateY(-50%);
    }

    .log-item:first-child .log-mark {
        background: var(--accent);
        border-color: var(--accent);
    }

    .log-entry {
        margin: 0;
        color: var(--text-strong);
        font-size: var(--fs-md);
        line-height: var(--lh-snug);
    }

    .log-meta {
        display: flex;
        align-items: center;
        gap: var(--sp-4);
        margin: 0;
        font-size: var(--fs-xs);
        letter-spacing: var(--tracking-wide);
    }

    .platform {
        color: var(--accent);
        text-transform: uppercase;
    }

    .log-status {
        padding: 0.15rem 0.6rem;
        color: var(--text-dim);
        border: 1px solid var(--border);
        border-radius: var(--radius-pill);
        white-space: nowrap;
    }

    .log-status[data-status="Bounty"] {
        color: var(--accent-strong);
        border-color: var(--accent-line);
        background: var(--accent-soft);
    }

    .disclosure {
        margin: var(--sp-5) 0 0;
        color: var(--text-faint);
        font-size: var(--fs-xs);
        line-height: var(--lh-snug);
    }

    /* --- Banda de metodología ------------------------------------------- */
    .loop-band {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
        align-items: center;
        gap: var(--sp-6);
        padding: var(--sp-6);
        background:
            linear-gradient(120deg, var(--accent-soft), transparent 60%),
            var(--surface);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius);
        color: inherit;
        transition: border-color var(--dur) var(--ease);
    }

    .loop-band:hover {
        border-color: var(--accent-line);
    }

    .loop-kicker {
        margin-bottom: var(--sp-2);
        color: var(--accent);
        font-size: var(--fs-xs);
        letter-spacing: var(--tracking-wider);
        text-transform: uppercase;
    }

    .loop-title {
        max-width: 26ch;
        margin-bottom: var(--sp-3);
        font-size: var(--fs-xl);
    }

    .loop-desc {
        max-width: 44ch;
        margin: 0;
        color: var(--text-dim);
        font-size: var(--fs-base);
    }

    /* Ciclo: cada paso se enciende por turnos, como un pipeline en marcha */
    .loop {
        display: flex;
        flex-wrap: wrap;
        gap: var(--sp-2);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .loop li {
        display: flex;
        align-items: center;
        gap: var(--sp-2);
        font-size: var(--fs-sm);
    }

    .loop li span {
        padding: var(--sp-2) var(--sp-4);
        background: var(--bg-soft);
        border: 1px solid var(--border);
        border-radius: var(--radius-pill);
        color: var(--text-dim);
        animation: loop-pulse 6s var(--ease) infinite;
        animation-delay: calc(var(--i) * 380ms);
    }

    .loop li:not(:last-child)::after {
        content: "→";
        color: var(--border-strong);
    }

    @keyframes loop-pulse {
        0%,
        12%,
        100% {
            border-color: var(--border);
            color: var(--text-dim);
        }
        4% {
            border-color: var(--accent-line);
            color: var(--accent-strong);
        }
    }

    /* --- Listados ------------------------------------------------------- */
    .rows {
        border-top: 1px solid var(--border);
    }

    .view-all {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-2);
        margin-top: var(--sp-6);
        color: var(--text-dim);
        font-size: var(--fs-sm);
    }

    .view-all:hover {
        color: var(--accent-strong);
    }

    .view-all span {
        transition: transform var(--dur) var(--ease);
    }

    .view-all:hover span {
        transform: translateX(3px);
    }

    @media (max-width: 900px) {
        .hero-inner {
            grid-template-columns: 1fr;
        }

        .hero-copy h1 {
            max-width: none;
        }

        /* El estado baja bajo la entrada en vez de comprimirla */
        .log-item {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @media (max-width: 860px) {
        .loop-band {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 520px) {
        .ctas .btn {
            flex: 1;
        }
    }
</style>
