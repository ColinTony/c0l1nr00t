---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRow from "../../components/PostRow.astro";
import Terminal from "../../components/Terminal.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../i18n/utils";
import { readingTime } from "../../utils/reading-time";
import {
    identity,
    researchAreas,
    statusLabels,
    findings,
    track,
    methodology,
} from "../../data/research";

const lang = "es";
const t = useTranslations(lang);

const posts = await getCollection("blog", ({ id, data }) => {
    return id.startsWith("es/") && !data.draft && data.visible !== false;
});

const sortedPosts = posts
    .sort((a, b) => {
        if (a.data.pinned && !b.data.pinned) return -1;
        if (!a.data.pinned && b.data.pinned) return 1;
        return b.data.date.valueOf() - a.data.date.valueOf();
    })
    .slice(0, 4);

const featured = findings[0];
const rest = findings.slice(1);
---

<BaseLayout
    title={`${identity.handle} | ${identity.role}`}
    description={`${identity.role} mexicano. ${identity.lead}`}
>
    <section class="hero">
        <div class="container hero-inner">
            <div class="hero-copy">
                <p class="eyebrow">
                    &gt; {identity.handle} · {identity.role}
                </p>
                <h1 data-scramble>{identity.tagline}</h1>
                <p class="lead">{identity.lead}</p>

                <div class="ctas">
                    <a href={`/${lang}/research`} class="btn btn-primary">
                        {t("cta.research")}
                    </a>
                    <a href={`/${lang}/about`} class="btn btn-outline">
                        {t("cta.about")}
                    </a>
                </div>

                <p class="hint mono">
                    <button type="button" class="hint-btn" data-palette-open>
                        <span class="kbd">Ctrl</span><span class="kbd">K</span>
                    </button>
                    para saltar a cualquier sección · o escribe
                    <code>help</code> en la terminal
                </p>
            </div>

            <Terminal />
        </div>
    </section>

    <section class="container section">
        <h2 class="section-title">{t("section.currently_researching")}</h2>

        <ul class="areas">
            {
                researchAreas.map((area, i) => (
                    <li
                        class="area"
                        data-spotlight
                        data-reveal
                        style={`--reveal-delay:${i * 45}ms`}
                    >
                        <div class="area-head">
                            <h3>{area.title}</h3>
                            <span class={`status is-${area.status}`}>
                                {statusLabels[area.status]}
                            </span>
                        </div>
                        <p>{area.summary}</p>
                    </li>
                ))
            }
        </ul>
    </section>

    <section class="container section-sm">
        <h2 class="section-title">{t("section.findings")}</h2>

        <article class="featured" data-spotlight data-reveal>
            <div class="featured-main">
                <p class="featured-meta mono">
                    <span class="platform">{featured.platform}</span>
                    <span class="sep" aria-hidden="true">/</span>
                    <span class="codename">{featured.codename}</span>
                </p>
                <h3>{featured.title}</h3>
                <p class="featured-desc">{featured.summary}</p>
            </div>
            <dl class="featured-side mono">
                <div>
                    <dt>{t("research.outcome")}</dt>
                    <dd>{featured.outcome}</dd>
                </div>
                <div>
                    <dt>{t("research.reward")}</dt>
                    <dd class="reward" data-count>{featured.reward}</dd>
                </div>
            </dl>
        </article>

        <ul class="findings">
            {
                rest.map((finding, i) => (
                    <li
                        class="finding"
                        data-spotlight
                        data-reveal
                        style={`--reveal-delay:${i * 70}ms`}
                    >
                        <p class="finding-meta mono">
                            <span class="platform">{finding.platform}</span>
                        </p>
                        <h3>{finding.title}</h3>
                        <p>{finding.summary}</p>
                        <p class="finding-outcome mono">{finding.outcome}</p>
                    </li>
                ))
            }
        </ul>

        <p class="disclosure mono">
            {t("research.disclosure")} · {track.rewards}
            {track.rewardsScope} ({track.rewardsAsOf}).
        </p>
    </section>

    <section class="container section-sm">
        <a href={`/${lang}/research#methodology`} class="loop-band" data-reveal>
            <div class="loop-band-copy">
                <p class="loop-kicker mono">How I work</p>
                <h2 class="loop-title">
                    Casi toda mi investigación empieza por preguntas, no por
                    herramientas.
                </h2>
                <p class="loop-desc">
                    Un scanner te dice qué responde; las preguntas te dicen
                    dónde mirar.
                </p>
            </div>

            <ol class="loop mono" aria-hidden="true">
                {
                    methodology.loop.map((step, i) => (
                        <li style={`--i:${i}`}>
                            <span>{step}</span>
                        </li>
                    ))
                }
            </ol>
        </a>
    </section>

    <section class="container section-sm">
        <h2 class="section-title">{t("section.latest_posts")}</h2>

        <div class="rows">
            {
                sortedPosts.map((post) => (
                    <PostRow
                        href={`/${lang}/blog/${post.slug.split("/")[1]}`}
                        title={post.data.title}
                        date={post.data.date}
                        description={post.data.description}
                        category={post.data.category}
                        type={post.data.type}
                        tags={post.data.tags}
                        readingTime={readingTime(post.body, t("blog.read_time"))}
                        pinned={post.data.pinned}
                    />
                ))
            }
        </div>

        <a href={`/${lang}/blog`} class="view-all mono">
            {t("section.view_all")} <span aria-hidden="true">→</span>
        </a>
    </section>
</BaseLayout>

<style>
    /* --- Hero ---------------------------------------------------------- */
    .hero {
        padding-block: clamp(3rem, 8vw, 5.5rem);
        border-bottom: 1px solid var(--border);
    }

    .hero-inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
        align-items: center;
        gap: clamp(2rem, 5vw, 4rem);
    }

    .hero-copy h1 {
        max-width: 18ch;
        margin-bottom: var(--sp-5);
        font-size: clamp(1.75rem, 1.2rem + 2.4vw, 3rem);
        text-wrap: pretty;
    }

    .lead {
        max-width: 48ch;
        margin-bottom: var(--sp-6);
        color: var(--text-dim);
        font-size: var(--fs-lg);
    }

    .ctas {
        display: flex;
        flex-wrap: wrap;
        gap: var(--sp-3);
    }

    .hint {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem;
        margin: var(--sp-5) 0 0;
        color: var(--text-faint);
        font-size: var(--fs-xs);
    }

    .hint-btn {
        display: inline-flex;
        gap: 3px;
        padding: 0;
        background: none;
        border: 0;
        cursor: pointer;
    }

    .hint code {
        background: var(--surface-2);
        color: var(--text-dim);
    }

    /* --- Currently researching ----------------------------------------- */
    .areas {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
        gap: 1px;
        margin: 0;
        padding: 0;
        list-style: none;
        background: var(--border);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
    }

    .area {
        padding: var(--sp-5);
        background: var(--surface);
        transition: background-color var(--dur) var(--ease);
    }

    .area:hover {
        background: var(--surface-2);
    }

    .area-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--sp-3);
        margin-bottom: var(--sp-2);
    }

    .area h3 {
        margin: 0;
        font-size: var(--fs-md);
        color: var(--text-strong);
    }

    .area p {
        margin: 0;
        color: var(--text-dim);
        font-size: var(--fs-base);
        line-height: var(--lh-snug);
    }

    .status {
        flex-shrink: 0;
        font-family: var(--font-mono);
        font-size: var(--fs-xs);
        color: var(--text-faint);
        letter-spacing: var(--tracking-wide);
    }

    .status.is-active {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--accent);
    }

    /* Latido solo en lo que está en curso */
    .status.is-active::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent);
        animation: pulse 2.4s var(--ease) infinite;
    }

    @keyframes pulse {
        0%,
        100% {
            opacity: 1;
            box-shadow: 0 0 0 0 var(--accent-soft);
        }
        50% {
            opacity: 0.55;
            box-shadow: 0 0 0 4px transparent;
        }
    }

    /* --- Findings ------------------------------------------------------- */
    .featured {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 14rem;
        gap: var(--sp-5);
        padding: var(--sp-6);
        background: var(--surface);
        border: 1px solid var(--accent-line);
        border-radius: var(--radius);
    }

    .featured-meta {
        display: flex;
        align-items: center;
        gap: var(--sp-3);
        margin-bottom: var(--sp-3);
        font-size: var(--fs-xs);
        letter-spacing: var(--tracking-wide);
    }

    .platform {
        color: var(--accent);
        text-transform: uppercase;
    }

    .sep {
        color: var(--border-strong);
    }

    .codename {
        color: var(--text-faint);
    }

    .featured h3 {
        margin-bottom: var(--sp-3);
        font-size: var(--fs-xl);
    }

    .featured-desc {
        max-width: 60ch;
        margin: 0;
        color: var(--text-dim);
    }

    .featured-side {
        display: flex;
        flex-direction: column;
        gap: var(--sp-4);
        margin: 0;
        padding-left: var(--sp-5);
        border-left: 1px solid var(--border);
    }

    .featured-side dt {
        margin-bottom: var(--sp-1);
        color: var(--text-faint);
        font-size: var(--fs-xs);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
    }

    .featured-side dd {
        margin: 0;
        color: var(--text);
        font-size: var(--fs-sm);
    }

    .reward {
        color: var(--accent-strong);
        font-size: var(--fs-lg) !important;
    }

    .findings {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
        gap: var(--sp-5);
        margin: var(--sp-5) 0 0;
        padding: 0;
        list-style: none;
    }

    .finding {
        display: flex;
        flex-direction: column;
        padding: var(--sp-5);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        transition:
            border-color var(--dur) var(--ease),
            transform var(--dur) var(--ease);
    }

    .finding:hover {
        border-color: var(--border-strong);
        transform: translateY(-2px);
    }

    .finding-meta {
        margin-bottom: var(--sp-2);
        font-size: var(--fs-xs);
        letter-spacing: var(--tracking-wide);
    }

    .finding h3 {
        margin-bottom: var(--sp-2);
        font-size: var(--fs-md);
    }

    .finding p {
        margin: 0;
        color: var(--text-dim);
        font-size: var(--fs-base);
        line-height: var(--lh-snug);
    }

    .finding-outcome {
        margin-top: auto !important;
        padding-top: var(--sp-3);
        border-top: 1px solid var(--border);
        color: var(--text-faint) !important;
        font-size: var(--fs-xs) !important;
    }

    .disclosure {
        margin: var(--sp-5) 0 0;
        color: var(--text-faint);
        font-size: var(--fs-xs);
        line-height: var(--lh-snug);
    }

    /* --- Banda de metodología ------------------------------------------- */
    .loop-band {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
        align-items: center;
        gap: var(--sp-6);
        padding: var(--sp-6);
        background:
            linear-gradient(120deg, var(--accent-soft), transparent 60%),
            var(--surface);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius);
        color: inherit;
        transition: border-color var(--dur) var(--ease);
    }

    .loop-band:hover {
        border-color: var(--accent-line);
    }

    .loop-kicker {
        margin-bottom: var(--sp-2);
        color: var(--accent);
        font-size: var(--fs-xs);
        letter-spacing: var(--tracking-wider);
        text-transform: uppercase;
    }

    .loop-title {
        max-width: 26ch;
        margin-bottom: var(--sp-3);
        font-size: var(--fs-xl);
    }

    .loop-desc {
        max-width: 44ch;
        margin: 0;
        color: var(--text-dim);
        font-size: var(--fs-base);
    }

    /* Ciclo: cada paso se enciende por turnos, como un pipeline en marcha */
    .loop {
        display: flex;
        flex-wrap: wrap;
        gap: var(--sp-2);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .loop li {
        display: flex;
        align-items: center;
        gap: var(--sp-2);
        font-size: var(--fs-sm);
    }

    .loop li span {
        padding: var(--sp-2) var(--sp-4);
        background: var(--bg-soft);
        border: 1px solid var(--border);
        border-radius: var(--radius-pill);
        color: var(--text-dim);
        animation: loop-pulse 6s var(--ease) infinite;
        animation-delay: calc(var(--i) * 380ms);
    }

    .loop li:not(:last-child)::after {
        content: "→";
        color: var(--border-strong);
    }

    @keyframes loop-pulse {
        0%,
        12%,
        100% {
            border-color: var(--border);
            color: var(--text-dim);
        }
        4% {
            border-color: var(--accent-line);
            color: var(--accent-strong);
        }
    }

    /* --- Listados ------------------------------------------------------- */
    .rows {
        border-top: 1px solid var(--border);
    }

    .view-all {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-2);
        margin-top: var(--sp-6);
        color: var(--text-dim);
        font-size: var(--fs-sm);
    }

    .view-all:hover {
        color: var(--accent-strong);
    }

    .view-all span {
        transition: transform var(--dur) var(--ease);
    }

    .view-all:hover span {
        transform: translateX(3px);
    }

    @media (max-width: 900px) {
        .hero-inner {
            grid-template-columns: 1fr;
        }

        .hero-copy h1 {
            max-width: none;
        }

        .featured {
            grid-template-columns: 1fr;
        }

        .featured-side {
            flex-direction: row;
            gap: var(--sp-6);
            padding: var(--sp-4) 0 0;
            border-left: none;
            border-top: 1px solid var(--border);
        }
    }

    @media (max-width: 860px) {
        .loop-band {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 520px) {
        .ctas .btn {
            flex: 1;
        }
    }
</style>
