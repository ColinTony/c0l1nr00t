---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PostRow from "../../../../components/PostRow.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../../../i18n/utils";
import { readingTime } from "../../../../utils/reading-time";

export async function getStaticPaths() {
    const posts = await getCollection(
        "blog",
        ({ id, data }) =>
            id.startsWith("es/") && !data.draft && data.visible !== false,
    );

    const years = [
        ...new Set(posts.map((post) => post.data.date.getFullYear())),
    ];

    return years.map((year) => ({
        params: { year: year.toString() },
        props: { year },
    }));
}

const { year } = Astro.props;
const lang = "es";
const t = useTranslations(lang);

const allPosts = await getCollection(
    "blog",
    ({ id, data }) =>
        id.startsWith("es/") && !data.draft && data.visible !== false,
);

const sortedPosts = allPosts
    .filter((post) => post.data.date.getFullYear() === year)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allYears = [
    ...new Set(allPosts.map((post) => post.data.date.getFullYear())),
].sort((a, b) => b - a);
---

<BaseLayout
    title={`c0l1nr00t | ${t("nav.blog")} · ${year}`}
    description={`Entradas del blog publicadas en ${year}.`}
>
    <div class="container section">
        <header class="page-header">
            <p class="eyebrow">&gt; ~/blog/archive/{year}</p>
            <h1>{t("blog.archive")} · {year}</h1>
            <p class="lead">
                {sortedPosts.length}
                {sortedPosts.length === 1 ? "entrada" : "entradas"} en {year}.
            </p>
        </header>

        <div class="layout">
            <div>
                <div class="rows">
                    {
                        sortedPosts.map((post) => (
                            <PostRow
                                href={`/${lang}/blog/${post.slug.split("/")[1]}`}
                                title={post.data.title}
                                date={post.data.date}
                                description={post.data.description}
                                category={post.data.category}
                                type={post.data.type}
                                tags={post.data.tags}
                                readingTime={readingTime(
                                    post.body,
                                    t("blog.read_time"),
                                )}
                            />
                        ))
                    }
                </div>

                <a href={`/${lang}/blog`} class="back-link return">
                    <span aria-hidden="true">←</span>
                    {t("blog.return")}
                </a>
            </div>

            <aside class="sidebar">
                <div class="panel">
                    <div class="panel-header">
                        <span>{t("blog.archive")}</span>
                        <span class="count">{allPosts.length}</span>
                    </div>
                    <ul class="archive">
                        {
                            allYears.map((y) => (
                                <li>
                                    <a
                                        href={`/${lang}/blog/archive/${y}`}
                                        class="mono"
                                        aria-current={
                                            y === year ? "page" : undefined
                                        }
                                    >
                                        <span>{y}</span>
                                        <span class="n">
                                            {
                                                allPosts.filter(
                                                    (p) =>
                                                        p.data.date.getFullYear() ===
                                                        y,
                                                ).length
                                            }
                                        </span>
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</BaseLayout>

<style>
    .layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 240px;
        gap: clamp(2rem, 5vw, 4rem);
        align-items: start;
    }

    .rows {
        border-top: 1px solid var(--border);
    }

    .return {
        margin-top: var(--sp-7);
    }

    .sidebar {
        position: sticky;
        top: calc(var(--header-h) + var(--sp-5));
    }

    .count {
        color: var(--text-faint);
    }

    .archive {
        margin: 0;
        padding: var(--sp-2);
        list-style: none;
    }

    .archive a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--sp-2) var(--sp-3);
        border-radius: var(--radius-sm);
        color: var(--text-dim);
        font-size: var(--fs-sm);
        transition:
            background-color var(--dur) var(--ease),
            color var(--dur) var(--ease);
    }

    .archive a:hover {
        background: var(--surface-2);
        color: var(--accent-strong);
    }

    .archive a[aria-current="page"] {
        background: var(--accent-soft);
        color: var(--accent-strong);
    }

    .archive .n {
        color: var(--text-faint);
        font-size: var(--fs-xs);
    }

    @media (max-width: 900px) {
        .layout {
            grid-template-columns: 1fr;
        }

        .sidebar {
            position: static;
        }
    }
</style>
