---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostRow from "../../../components/PostRow.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "../../../i18n/utils";
import { readingTime } from "../../../utils/reading-time";
import { slugify } from "../../../utils/slug";
import { postTypes } from "../../../data/research";

export async function getStaticPaths({ paginate }) {
    const posts = await getCollection("blog", ({ id, data }) => {
        return id.startsWith("es/") && !data.draft && data.visible !== false;
    });

    const sortedPosts = posts.sort((a, b) => {
        if (a.data.pinned && !b.data.pinned) return -1;
        if (!a.data.pinned && b.data.pinned) return 1;
        return b.data.date.valueOf() - a.data.date.valueOf();
    });

    return paginate(sortedPosts, { pageSize: 8 });
}

const { page } = Astro.props;
const lang = "es";
const t = useTranslations(lang);

const allPosts = await getCollection("blog", ({ id, data }) => {
    return id.startsWith("es/") && !data.draft && data.visible !== false;
});

// Solo se listan las categorías que tienen entradas: nada de secciones vacías.
const categories = [
    ...new Set(allPosts.map((post) => post.data.category).filter(Boolean)),
]
    .map((name) => ({
        name,
        slug: slugify(name as string),
        count: allPosts.filter((post) => post.data.category === name).length,
    }))
    .sort((a, b) => b.count - a.count);

const years = [
    ...new Set(allPosts.map((post) => post.data.date.getFullYear())),
].sort((a, b) => b - a);
---

<BaseLayout
    title={`c0l1nr00t | ${t("nav.blog")}`}
    description="Research notes, lab notes y deep dives sobre dispositivos, browsers embebidos, fuzzing y memory corruption."
>
    <div class="container section">
        <header class="page-header">
            <p class="eyebrow">&gt; ~/blog</p>
            <h1>Research Log</h1>
            <p class="lead">
                Notas de investigación, experimentos de laboratorio y deep
                dives. No todo termina en vulnerabilidad — esa parte también se
                publica.
            </p>
        </header>

        <div class="layout">
            <div>
                {
                    page.data.length > 0 ? (
                        <div class="rows">
                            {page.data.map((post) => (
                                <PostRow
                                    href={`/${lang}/blog/${post.slug.split("/")[1]}`}
                                    title={post.data.title}
                                    date={post.data.date}
                                    description={post.data.description}
                                    category={post.data.category}
                                    type={post.data.type}
                                    tags={post.data.tags}
                                    readingTime={readingTime(
                                        post.body,
                                        t("blog.read_time"),
                                    )}
                                    pinned={post.data.pinned}
                                />
                            ))}
                        </div>
                    ) : (
                        <p class="empty-state">{t("blog.empty")}</p>
                    )
                }

                {
                    page.lastPage > 1 && (
                        <nav class="pagination mono" aria-label="Paginación">
                            {page.url.prev ? (
                                <a href={page.url.prev} class="btn btn-outline btn-sm">
                                    ← {t("blog.prev")}
                                </a>
                            ) : (
                                <span class="btn btn-outline btn-sm" aria-disabled="true">
                                    ← {t("blog.prev")}
                                </span>
                            )}

                            <span class="page-info">
                                {t("blog.page")} {page.currentPage} / {page.lastPage}
                            </span>

                            {page.url.next ? (
                                <a href={page.url.next} class="btn btn-outline btn-sm">
                                    {t("blog.next")} →
                                </a>
                            ) : (
                                <span class="btn btn-outline btn-sm" aria-disabled="true">
                                    {t("blog.next")} →
                                </span>
                            )}
                        </nav>
                    )
                }
            </div>

            <aside class="sidebar">
                {
                    categories.length > 0 && (
                        <div class="panel">
                            <div class="panel-header">
                                <span>{t("blog.categories")}</span>
                            </div>
                            <ul class="side-list">
                                {categories.map((category) => (
                                    <li>
                                        <a
                                            href={`/${lang}/blog/categoria/${category.slug}`}
                                            class="mono"
                                        >
                                            <span>{category.name}</span>
                                            <span class="n">
                                                {category.count}
                                            </span>
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    )
                }

                <div class="panel">
                    <div class="panel-header">
                        <span>{t("blog.archive")}</span>
                        <span class="count">{allPosts.length}</span>
                    </div>
                    <ul class="side-list">
                        {
                            years.map((year) => (
                                <li>
                                    <a
                                        href={`/${lang}/blog/archive/${year}`}
                                        class="mono"
                                    >
                                        <span>{year}</span>
                                        <span class="n">
                                            {
                                                allPosts.filter(
                                                    (p) =>
                                                        p.data.date.getFullYear() ===
                                                        year,
                                                ).length
                                            }
                                        </span>
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <span>{t("section.post_types")}</span>
                    </div>
                    <ul class="types">
                        {
                            postTypes.map((type) => (
                                <li>
                                    <span class="type-name mono">
                                        {type.name}
                                    </span>
                                    <span class="type-detail">
                                        {type.detail}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</BaseLayout>

<style>
    .layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 260px;
        gap: clamp(2rem, 5vw, 4rem);
        align-items: start;
    }

    .rows {
        border-top: 1px solid var(--border);
    }

    .pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp-4);
        margin-top: var(--sp-7);
    }

    .page-info {
        color: var(--text-faint);
        font-size: var(--fs-xs);
        letter-spacing: var(--tracking-wide);
    }

    .sidebar {
        position: sticky;
        top: calc(var(--header-h) + var(--sp-5));
        display: flex;
        flex-direction: column;
        gap: var(--sp-4);
    }

    .count {
        color: var(--text-faint);
    }

    .side-list {
        margin: 0;
        padding: var(--sp-2);
        list-style: none;
    }

    .side-list a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp-3);
        padding: var(--sp-2) var(--sp-3);
        border-radius: var(--radius-sm);
        color: var(--text-dim);
        font-size: var(--fs-sm);
        transition:
            background-color var(--dur) var(--ease),
            color var(--dur) var(--ease);
    }

    .side-list a:hover {
        background: var(--surface-2);
        color: var(--accent-strong);
    }

    .side-list .n {
        color: var(--text-faint);
        font-size: var(--fs-xs);
    }

    .types {
        margin: 0;
        padding: var(--sp-4);
        list-style: none;
    }

    .types li {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding-block: var(--sp-2);
        border-bottom: 1px solid var(--border);
    }

    .types li:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .type-name {
        color: var(--text);
        font-size: var(--fs-xs);
        letter-spacing: var(--tracking-wide);
    }

    .type-detail {
        color: var(--text-faint);
        font-size: var(--fs-xs);
        line-height: var(--lh-snug);
    }

    @media (max-width: 900px) {
        .layout {
            grid-template-columns: 1fr;
        }

        .sidebar {
            position: static;
        }
    }

    @media (max-width: 520px) {
        .pagination {
            flex-wrap: wrap;
            justify-content: center;
        }
    }
</style>
