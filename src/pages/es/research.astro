---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Standing from "../../components/Standing.astro";
import { useTranslations } from "../../i18n/utils";
import {
    identity,
    platforms,
    researchLog,
    methodology,
    hardware,
} from "../../data/research";

const lang = "es";
const t = useTranslations(lang);

const sections = [
    { id: "platforms", label: t("section.platforms") },
    { id: "log", label: t("section.research_log") },
    { id: "methodology", label: t("section.methodology") },
    { id: "hardware", label: t("section.hardware") },
];
---

<BaseLayout
    title={`${identity.handle} | Security Research`}
    description="Investigación en dispositivos Amazon (Kindle, Fire TV, Echo Show, Ring), browsers embebidos, parsers, fuzzing y memory corruption."
    image="/og/research.png"
>
    <div class="container section">
        <header class="page-header">
            <p class="eyebrow">&gt; ~/research</p>
            <h1>{t("research.title")}</h1>
            <p class="lead">{t("research.lead")}</p>
        </header>

        <p class="disclosure-banner mono">
            <span aria-hidden="true">⚠</span>
            {t("research.disclosure")}
        </p>

        <div class="layout">
            <nav class="rail" aria-label="Secciones de esta página">
                <ol class="rail-list mono">
                    {
                        sections.map((section, i) => (
                            <li>
                                <a href={`#${section.id}`} data-rail={section.id}>
                                    <span class="n">
                                        {String(i + 1).padStart(2, "0")}
                                    </span>
                                    <span>{section.label}</span>
                                </a>
                            </li>
                        ))
                    }
                </ol>
            </nav>

            <div class="blocks">
                <!-- Plataformas ------------------------------------------ -->
                <section class="block" id="platforms">
                    <h2 class="section-title">{t("section.platforms")}</h2>

                    <div class="platforms">
                        {
                            platforms.map((platform, i) => (
                                <article
                                    class="panel platform"
                                    id={platform.id}
                                    data-spotlight
                                    data-reveal
                                    style={`--reveal-delay:${i * 60}ms`}
                                >
                                    <div class="panel-header">
                                        <span>{platform.name}</span>
                                        <span class="device">
                                            {platform.device}
                                        </span>
                                    </div>
                                    <div class="panel-content">
                                        <p class="platform-intro">
                                            {platform.intro}
                                        </p>

                                        <p class="label mono">
                                            {t("research.surfaces")}
                                            <span class="count">
                                                {platform.surfaces.length}
                                            </span>
                                        </p>
                                        <ul class="surfaces">
                                            {platform.surfaces.map(
                                                (surface, s) => (
                                                    <li
                                                        class="chip"
                                                        style={`--i:${s}`}
                                                    >
                                                        {surface}
                                                    </li>
                                                ),
                                            )}
                                        </ul>
                                    </div>
                                </article>
                            ))
                        }
                    </div>
                </section>

                <!-- Registro de investigación ---------------------------- -->
                <section class="block" id="log">
                    <div class="section-head">
                        <h2 class="section-title">
                            {t("section.research_log")}
                        </h2>
                        <Standing />
                    </div>

                    <ol class="log">
                        {
                            researchLog.map((item, i) => (
                                <li
                                    class="log-item"
                                    data-spotlight
                                    data-reveal
                                    style={`--reveal-delay:${i * 60}ms`}
                                >
                                    <span class="log-mark" aria-hidden="true" />
                                    <p class="log-entry">{item.entry}</p>
                                    <p class="log-meta mono">
                                        <span class="platform-tag">
                                            {item.platform}
                                        </span>
                                        <span
                                            class="log-status"
                                            data-status={item.status}
                                        >
                                            {item.status}
                                        </span>
                                    </p>
                                </li>
                            ))
                        }
                    </ol>

                    <p class="track mono">
                        El registro dice qué hice y en qué estado quedó, nunca
                        qué encontré. Los reportes siguen divulgación coordinada
                        con el fabricante: si algún día uno se hace público,
                        aparecerá como writeup y no ampliando esta lista.
                    </p>
                </section>

                <!-- Metodología ------------------------------------------- -->
                <section class="block" id="methodology">
                    <h2 class="section-title">{t("section.methodology")}</h2>

                    <ol class="loop mono">
                        {
                            methodology.loop.map((step, i) => (
                                <li style={`--i:${i}`}>
                                    <span>{step}</span>
                                </li>
                            ))
                        }
                    </ol>

                    <p class="loop-note">
                        Casi toda mi investigación empieza por preguntas, no por
                        herramientas. Un scanner te dice qué responde; estas
                        preguntas te dicen dónde mirar.
                    </p>

                    <ul class="questions">
                        {
                            methodology.questions.map((question, i) => (
                                <li data-reveal style={`--reveal-delay:${i * 40}ms`}>
                                    <span class="q mono" aria-hidden="true">
                                        ?
                                    </span>
                                    {question}
                                </li>
                            ))
                        }
                    </ul>
                </section>

                <!-- Hardware ---------------------------------------------- -->
                <section class="block" id="hardware">
                    <h2 class="section-title">{t("section.hardware")}</h2>

                    <p class="hardware-note">
                        Si una entrada puede llegar al dispositivo por radio,
                        HDMI, navegador, voz, archivo, protocolo o periférico,
                        es una superficie de investigación. Parte del trabajo
                        consiste en construir mis propias herramientas para
                        alcanzarla.
                    </p>

                    <dl class="hardware">
                        {
                            hardware.map((item, i) => (
                                <div
                                    class="hw"
                                    data-spotlight
                                    data-reveal
                                    style={`--reveal-delay:${i * 50}ms`}
                                >
                                    <dt class="mono">{item.name}</dt>
                                    <dd>{item.use}</dd>
                                </div>
                            ))
                        }
                    </dl>
                </section>

                <!-- Salidas ------------------------------------------------ -->
                <section class="block outro">
                    <div class="outro-card" data-spotlight data-reveal>
                        <h2>Research logs</h2>
                        <p>
                            Notas de investigación, lab notes y deep dives
                            conforme avanzan. No todo termina en vulnerabilidad,
                            y esa parte también se publica.
                        </p>
                        <a href={`/${lang}/blog`} class="btn btn-primary">
                            $ leer el blog
                        </a>
                    </div>

                    <div
                        class="outro-card"
                        data-spotlight
                        data-reveal
                        style="--reveal-delay:80ms"
                    >
                        <h2>Writeups</h2>
                        <p>
                            Writeups técnicos completos, publicados cuando la
                            divulgación coordinada lo permite.
                        </p>
                        <a href={`/${lang}/writeups`} class="btn btn-outline">
                            $ ver writeups
                        </a>
                    </div>
                </section>
            </div>
        </div>
    </div>
</BaseLayout>

<script>
    // El índice lateral marca la sección que se está leyendo
    function setupRail() {
        const links = Array.from(
            document.querySelectorAll<HTMLAnchorElement>("[data-rail]"),
        );
        if (!links.length || !("IntersectionObserver" in window)) return;

        const byId = new Map(links.map((link) => [link.dataset.rail, link]));
        const sections = links
            .map((link) => document.getElementById(link.dataset.rail ?? ""))
            .filter((el): el is HTMLElement => Boolean(el));

        // Arriba del todo todavía no hay ninguna sección en la franja activa
        links[0].classList.add("is-active");

        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    links.forEach((link) => link.classList.remove("is-active"));
                    byId.get(entry.target.id)?.classList.add("is-active");
                }
            },
            { rootMargin: "-20% 0px -60% 0px", threshold: 0 },
        );

        sections.forEach((section) => observer.observe(section));
    }

    setupRail();
    document.addEventListener("astro:page-load", setupRail);
</script>

<style>
    .layout {
        display: grid;
        grid-template-columns: 190px minmax(0, 1fr);
        gap: clamp(2rem, 5vw, 4rem);
        align-items: start;
        margin-top: var(--sp-8);
    }

    /* Sin esto el índice horizontal (enlaces sin partir) ensancha la columna */
    .rail,
    .blocks {
        min-width: 0;
    }

    /* --- Índice lateral --------------------------------------------------- */
    .rail {
        position: sticky;
        top: calc(var(--header-h) + var(--sp-6));
    }

    .rail-list {
        margin: 0;
        padding: 0;
        list-style: none;
        border-left: 1px solid var(--border);
    }

    .rail-list a {
        display: flex;
        align-items: baseline;
        gap: var(--sp-3);
        margin-left: -1px;
        padding: var(--sp-2) var(--sp-4);
        border-left: 1px solid transparent;
        color: var(--text-faint);
        font-size: var(--fs-xs);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
        transition:
            color var(--dur) var(--ease),
            border-color var(--dur) var(--ease);
    }

    .rail-list a:hover {
        color: var(--text-dim);
    }

    .rail-list a.is-active {
        border-left-color: var(--accent);
        color: var(--accent-strong);
    }

    .rail-list .n {
        color: var(--border-strong);
    }

    .rail-list a.is-active .n {
        color: var(--accent);
    }

    .block {
        margin-top: var(--sp-9);
        scroll-margin-top: calc(var(--header-h) + var(--sp-6));
    }

    .block:first-child {
        margin-top: 0;
    }

    .label {
        display: flex;
        align-items: center;
        gap: var(--sp-2);
        margin-bottom: var(--sp-3);
        color: var(--text-faint);
        font-size: var(--fs-xs);
        letter-spacing: var(--tracking-wider);
        text-transform: uppercase;
    }

    .label .count {
        padding: 0 0.35rem;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--text-dim);
        letter-spacing: 0;
    }

    .disclosure-banner {
        display: flex;
        align-items: flex-start;
        gap: var(--sp-3);
        margin: 0;
        padding: var(--sp-3) var(--sp-4);
        background: color-mix(in srgb, var(--warn) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--warn) 35%, transparent);
        border-radius: var(--radius-sm);
        color: var(--warn);
        font-size: var(--fs-sm);
        line-height: var(--lh-snug);
    }

    /* --- Plataformas ---------------------------------------------------- */
    .platforms {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
        gap: var(--sp-5);
    }

    .platform {
        scroll-margin-top: calc(var(--header-h) + var(--sp-5));
        transition: border-color var(--dur) var(--ease);
    }

    .platform:hover {
        border-color: var(--border-strong);
    }

    .panel-header .device {
        color: var(--text-faint);
        text-transform: none;
        letter-spacing: 0;
    }

    .platform-intro {
        margin-bottom: var(--sp-5);
        color: var(--text-dim);
        font-size: var(--fs-base);
        line-height: var(--lh-snug);
    }

    .surfaces {
        display: flex;
        flex-wrap: wrap;
        gap: var(--sp-2);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .surfaces .chip {
        transition:
            border-color var(--dur) var(--ease),
            color var(--dur) var(--ease);
    }

    .platform:hover .chip {
        border-color: var(--border-strong);
    }

    .surfaces .chip:hover {
        border-color: var(--accent-line);
        color: var(--accent-strong);
    }

    /* --- Registro de investigación ---------------------------------------- */
    /* El título trae su propia línea de continuación, así que la credencial
       se cuelga al final de esa línea en vez de dentro del encabezado. */
    .section-head {
        display: flex;
        align-items: center;
        gap: var(--sp-4);
        margin-bottom: var(--sp-6);
    }

    .section-head .section-title {
        flex: 1;
        min-width: 0;
        margin-bottom: 0;
    }

    .log {
        margin: 0;
        padding: 0 0 0 var(--sp-5);
        border-left: 1px solid var(--border);
        list-style: none;
    }

    .log-item {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: var(--sp-3) var(--sp-5);
        padding: var(--sp-4) var(--sp-5);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        transition:
            border-color var(--dur) var(--ease),
            transform var(--dur) var(--ease);
    }

    .log-item + .log-item {
        margin-top: var(--sp-3);
    }

    .log-item:hover {
        transform: translateX(2px);
        border-color: var(--border-strong);
    }

    /* El punto se apoya sobre la línea vertical de la lista */
    .log-mark {
        position: absolute;
        top: 50%;
        left: calc(var(--sp-5) * -1 - 4px);
        width: 7px;
        height: 7px;
        background: var(--bg);
        border: 1px solid var(--border-strong);
        border-radius: 50%;
        transform: translateY(-50%);
    }

    .log-item:first-child .log-mark {
        background: var(--accent);
        border-color: var(--accent);
    }

    .log-entry {
        margin: 0;
        color: var(--text-strong);
        font-size: var(--fs-md);
        line-height: var(--lh-snug);
    }

    .log-meta {
        display: flex;
        align-items: center;
        gap: var(--sp-4);
        margin: 0;
        font-size: var(--fs-xs);
        letter-spacing: var(--tracking-wide);
    }

    .platform-tag {
        color: var(--accent);
        text-transform: uppercase;
    }

    .log-status {
        padding: 0.15rem 0.6rem;
        color: var(--text-dim);
        border: 1px solid var(--border);
        border-radius: var(--radius-pill);
        white-space: nowrap;
    }

    .log-status[data-status="Bounty"] {
        color: var(--accent-strong);
        border-color: var(--accent-line);
        background: var(--accent-soft);
    }

    .track {
        max-width: 82ch;
        margin: var(--sp-5) 0 0;
        color: var(--text-dim);
        font-size: var(--fs-sm);
        line-height: var(--lh-snug);
    }

    /* --- Metodología ------------------------------------------------------ */
    .loop {
        display: flex;
        flex-wrap: wrap;
        gap: var(--sp-2);
        margin: 0 0 var(--sp-5);
        padding: 0;
        list-style: none;
    }

    .loop li {
        display: flex;
        align-items: center;
        gap: var(--sp-2);
        color: var(--text-dim);
        font-size: var(--fs-sm);
    }

    .loop li span {
        padding: var(--sp-2) var(--sp-4);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-pill);
        animation: loop-pulse 6s var(--ease) infinite;
        animation-delay: calc(var(--i) * 380ms);
    }

    .loop li:not(:last-child)::after {
        content: "→";
        color: var(--accent);
    }

    @keyframes loop-pulse {
        0%,
        12%,
        100% {
            border-color: var(--border);
            color: var(--text-dim);
        }
        4% {
            border-color: var(--accent-line);
            color: var(--accent-strong);
        }
    }

    .loop-note {
        max-width: 68ch;
        color: var(--text-dim);
    }

    .questions {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
        gap: var(--sp-3) var(--sp-6);
        margin: var(--sp-5) 0 0;
        padding: 0;
        list-style: none;
    }

    .questions li {
        display: flex;
        gap: var(--sp-3);
        padding-bottom: var(--sp-3);
        border-bottom: 1px solid var(--border);
        color: var(--text);
        font-size: var(--fs-base);
        line-height: var(--lh-snug);
    }

    .q {
        color: var(--accent);
        flex-shrink: 0;
    }

    /* --- Hardware ---------------------------------------------------------- */
    .hardware-note {
        max-width: 68ch;
        color: var(--text-dim);
    }

    .hardware {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
        gap: var(--sp-3);
        margin: var(--sp-5) 0 0;
    }

    .hw {
        padding: var(--sp-4) var(--sp-5);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        transition: border-color var(--dur) var(--ease);
    }

    .hw:hover {
        border-color: var(--border-strong);
    }

    .hw dt {
        margin-bottom: var(--sp-1);
        color: var(--accent);
        font-size: var(--fs-sm);
    }

    .hw dd {
        margin: 0;
        color: var(--text-dim);
        font-size: var(--fs-base);
        line-height: var(--lh-snug);
    }

    /* --- Salidas ------------------------------------------------------------ */
    .outro {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
        gap: var(--sp-5);
        padding-top: var(--sp-7);
        border-top: 1px solid var(--border);
    }

    .outro-card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--sp-3);
        padding: var(--sp-5);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        transition: border-color var(--dur) var(--ease);
    }

    .outro-card:hover {
        border-color: var(--border-strong);
    }

    .outro-card h2 {
        margin: 0;
        font-size: var(--fs-lg);
    }

    .outro-card p {
        flex: 1;
        margin: 0;
        color: var(--text-dim);
        font-size: var(--fs-base);
    }

    /* --- Responsive --------------------------------------------------------- */
    @media (max-width: 1000px) {
        .layout {
            grid-template-columns: minmax(0, 1fr);
            gap: var(--sp-5);
        }

        /* El índice pasa a ser una tira horizontal pegada bajo la cabecera */
        .rail {
            top: var(--header-h);
            z-index: 20;
            margin-inline: calc(var(--sp-4) * -1);
            padding-inline: var(--sp-4);
            background: color-mix(in srgb, var(--bg) 92%, transparent);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--border);
        }

        .rail-list {
            display: flex;
            gap: var(--sp-1);
            overflow-x: auto;
            border-left: none;
            scrollbar-width: none;
        }

        .rail-list::-webkit-scrollbar {
            display: none;
        }

        .rail-list a {
            margin-left: 0;
            padding: var(--sp-3) var(--sp-3);
            border-left: none;
            border-bottom: 1px solid transparent;
            white-space: nowrap;
        }

        .rail-list a.is-active {
            border-left-color: transparent;
            border-bottom-color: var(--accent);
        }

        .rail-list .n {
            display: none;
        }

        .block {
            margin-top: var(--sp-8);
            scroll-margin-top: calc(var(--header-h) * 2 + var(--sp-4));
        }

        /* El estado baja bajo la entrada en vez de comprimirla */
        .log-item {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
