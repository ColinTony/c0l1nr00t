---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Standing from "../../components/Standing.astro";
import { useTranslations } from "../../i18n/utils";
import "../../styles/pages/about.css";
import {
    identity,
    timeline,
    pentesting,
    methodology,
} from "../../data/research";

const lang = "es";
const t = useTranslations(lang);

const metrics = [
    { value: "+15", label: "Bounty-awarded reports" },
    { value: "+35", label: "Private findings" },
    { value: "Top 20", label: "Cyscope ranking" },
];

const toolset = [
    { key: "DEVICE_RESEARCH", value: "Kindle · Fire TV · Echo Show · Ring" },
    { key: "HARDWARE", value: "ESP32 · Raspberry Pi · capturadora HDMI · adaptadores BT/Wi-Fi" },
    { key: "RE_TOOLING", value: "Ghidra · radare2 · objdump/readelf · binwalk" },
    { key: "DEBUG_TRACE", value: "GDB (pwndbg/gef) · strace/ltrace · perf" },
    { key: "FUZZING_LABS", value: "AFL++ · pwntools · sanitizers · QEMU" },
    { key: "WEB_TESTING", value: "Burp Suite · Postman · Insomnia" },
    { key: "RECONNAISSANCE", value: "subfinder · bbot · httpx · nuclei" },
    { key: "AUTOMATION", value: "Python · Node.js · TypeScript · Java" },
];
---

<BaseLayout
    title={`${identity.handle} | ${t("nav.about")}`}
    description={`${identity.role} mexicano. De web security a device research: Kindle, Fire TV, Echo Show, Ring, browsers embebidos, fuzzing y memory corruption.`}
    image="/og/about.png"
>
    <div class="container section">
        <header class="page-header about-header">
            <div>
                <p class="eyebrow">&gt; ~/about</p>
                <h1>{identity.handle}</h1>
                <p class="lead">
                    {identity.role} · {identity.location}
                </p>
            </div>
            <div class="header-badges">
                <Standing />
                <span class="badge">
                    <span class="pulse" aria-hidden="true"></span>
                    Status: Researching
                </span>
            </div>
        </header>

        <section class="panel intro-panel" data-spotlight>
            <div class="panel-header"><span>01_BIO</span></div>
            <div class="panel-content">
                <p class="intro-lead">{identity.short}</p>
                <p>
                    Mi origen técnico está en <strong>seguridad web</strong>,
                    pentesting y bug bounty. En los últimos años la
                    investigación se movió hacia superficies más complejas:
                    dispositivos, navegadores embebidos, sistemas embebidos,
                    APIs internas, parsers, protocolos e interfaces entre
                    dispositivos. Kindle fue la puerta de entrada; después
                    llegaron Fire TV, Echo Show y Ring.
                </p>
                <p class="intro-close">
                    Lo que me mueve no son las herramientas: es entender por qué
                    existe un comportamiento, quién controla la entrada y qué
                    pasa cuando esa frontera de confianza se rompe. Una
                    vulnerabilidad pequeña suele ser la primera pista de una
                    arquitectura mucho más interesante.
                </p>
            </div>
        </section>

        <section class="metrics" aria-label="Trayectoria">
            {
                metrics.map((metric, i) => (
                    <div
                        class="metric"
                        data-spotlight
                        data-reveal
                        style={`--reveal-delay:${i * 70}ms`}
                    >
                        <span class="metric-value mono" data-count>
                            {metric.value}
                        </span>
                        <span class="metric-label mono">{metric.label}</span>
                    </div>
                ))
            }
            <!-- Sin data-count: no es un número y no hay nada que contar -->
            <div
                class="metric"
                data-spotlight
                data-reveal
                style={`--reveal-delay:${metrics.length * 70}ms`}
            >
                <span class="metric-value mono">Bounty</span>
                <span class="metric-label mono">Amazon Devices</span>
            </div>
        </section>

        <!-- Evolución -------------------------------------------------- -->
        <section class="block">
            <h2 class="section-title">{t("section.timeline")}</h2>

            <ol class="timeline">
                {
                    timeline.map((step, i) => (
                        <li
                            class={step.current ? "is-current" : ""}
                            data-reveal
                            style={`--reveal-delay:${i * 60}ms`}
                        >
                            <span class="dot" aria-hidden="true" />
                            <div>
                                <h3 class="mono">{step.stage}</h3>
                                <p>{step.detail}</p>
                            </div>
                        </li>
                    ))
                }
            </ol>

            <p class="timeline-note">
                No me presento como exploit developer: esa parte todavía la estoy
                construyendo. Lo que sí puedo enseñar es la transición —
                <strong>web hacker convirtiéndose en device researcher</strong>
                — y el trabajo que la sostiene.
            </p>

            <a href={`/${lang}/research`} class="inline-cta mono">
                Ver la investigación en detalle <span aria-hidden="true">→</span>
            </a>
        </section>

        <!-- Metodología ------------------------------------------------- -->
        <section class="block">
            <h2 class="section-title">{t("section.methodology")}</h2>

            <ol class="loop mono">
                {
                    methodology.loop.map((step, i) => (
                        <li style={`--i:${i}`}>
                            <span>{step}</span>
                        </li>
                    ))
                }
            </ol>
        </section>

        <!-- Toolset + trabajo profesional ------------------------------- -->
        <div class="about-grid">
            <section class="panel" data-spotlight>
                <div class="panel-header"><span>02_TOOLSET</span></div>
                <div class="panel-content">
                    <dl class="data-list">
                        {
                            toolset.map((item) => (
                                <div class="data-item">
                                    <dt class="mono">{item.key}</dt>
                                    <dd>{item.value}</dd>
                                </div>
                            ))
                        }
                    </dl>
                </div>
            </section>

            <section class="panel" data-spotlight>
                <div class="panel-header">
                    <span>03_PROFESSIONAL_WORK</span>
                    <span class="device">pentesting</span>
                </div>
                <div class="panel-content">
                    <p class="pentest-intro">{pentesting.intro}</p>

                    <p class="label mono">Hallazgos habituales</p>
                    <ul class="chips">
                        {
                            pentesting.findings.map((item) => (
                                <li class="chip">{item}</li>
                            ))
                        }
                    </ul>

                    <p class="label mono">Proceso</p>
                    <ol class="process mono">
                        {pentesting.process.map((step) => <li>{step}</li>)}
                    </ol>
                </div>
            </section>
        </div>

        <div class="about-cta">
            <p class="mono">
                ¿Investigación, pentest o simplemente hablar de dispositivos?
            </p>
            <a href={`/${lang}/contact`} class="btn btn-primary btn-lg">
                &gt; initiate_contact
            </a>
        </div>
    </div>
</BaseLayout>
