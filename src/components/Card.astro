---
interface Props {
    href: string;
    title: string;
    date?: Date;
    description?: string;
    tags?: string[];
    difficulty?: string;
    platform?: string;
}

const { href, title, date, description, tags, difficulty, platform } =
    Astro.props;

const isoDate = date?.toISOString().split("T")[0];
---

<article class="card">
    <a class="card-link" href={href}>
        <header class="card-head">
            {platform && <span class="platform mono">{platform}</span>}
            {
                isoDate && (
                    <time class="date mono" datetime={isoDate}>
                        {isoDate}
                    </time>
                )
            }
        </header>

        <h3 class="card-title">{title}</h3>

        {description && <p class="desc">{description}</p>}

        <footer class="card-foot">
            {
                difficulty && (
                    <span class={`difficulty ${difficulty}`}>{difficulty}</span>
                )
            }
            {
                tags && tags.length > 0 && (
                    <span class="tags mono">
                        {tags.slice(0, 3).map((tag) => (
                            <span class="tag">#{tag}</span>
                        ))}
                    </span>
                )
            }
            <span class="go mono" aria-hidden="true">→</span>
        </footer>
    </a>
</article>

<style>
    .card {
        height: 100%;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        transition:
            border-color var(--dur) var(--ease),
            background-color var(--dur) var(--ease),
            transform var(--dur) var(--ease);
    }

    .card:hover {
        transform: translateY(-2px);
        border-color: var(--border-strong);
        background: var(--surface-2);
    }

    .card:has(.card-link:focus-visible) {
        border-color: var(--accent-line);
    }

    .card-link {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: var(--sp-5);
        color: inherit;
    }

    .card-link:focus-visible {
        outline: none;
    }

    .card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp-3);
        margin-bottom: var(--sp-3);
        font-size: var(--fs-xs);
    }

    .platform {
        color: var(--accent);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
    }

    .date {
        margin-left: auto;
        color: var(--text-faint);
    }

    .card-title {
        margin-bottom: var(--sp-2);
        font-size: var(--fs-lg);
        line-height: var(--lh-snug);
        color: var(--text-strong);
        transition: color var(--dur) var(--ease);
    }

    .card:hover .card-title {
        color: var(--accent-strong);
    }

    .desc {
        margin-bottom: var(--sp-5);
        color: var(--text-dim);
        font-size: var(--fs-base);
        line-height: var(--lh-snug);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-foot {
        display: flex;
        align-items: center;
        gap: var(--sp-3);
        margin-top: auto;
        padding-top: var(--sp-3);
        border-top: 1px solid var(--border);
    }

    .tags {
        display: flex;
        gap: var(--sp-2);
        overflow: hidden;
    }

    .go {
        margin-left: auto;
        color: var(--text-faint);
        transition:
            transform var(--dur) var(--ease),
            color var(--dur) var(--ease);
    }

    .card:hover .go {
        transform: translateX(3px);
        color: var(--accent);
    }
</style>
