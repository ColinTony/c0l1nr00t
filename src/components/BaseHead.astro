---
import "../styles/global.css";
import { identity } from "../data/research";

interface Props {
	title: string;
	description: string;
	image?: string;
	lang: string;
	/** "article" en entradas de blog y writeups; "website" en el resto. */
	type?: "website" | "article";
	publishedDate?: Date;
	tags?: string[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = "/og/default.png",
	lang,
	type = "website",
	publishedDate,
	tags = [],
} = Astro.props;

const socials = [
	"https://github.com/ColinTony",
	"https://www.linkedin.com/in/luisantoniocolin/",
	"https://x.com/c0l1nr00t",
];

const keywords = [
	"security researcher",
	"vulnerability research",
	"device security",
	"Amazon Devices",
	"Kindle security",
	"Fire TV",
	"Echo Show",
	"Ring",
	"browser security",
	"embedded security",
	"fuzzing",
	"memory corruption",
	"bug bounty",
	"pentesting",
	"c0l1nr00t",
	...tags,
];

const person = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: identity.handle,
	alternateName: "Luis Antonio Colín",
	jobTitle: identity.role,
	description: identity.short,
	url: Astro.site?.href,
	nationality: "Mexican",
	knowsAbout: [
		"Vulnerability research",
		"Device security",
		"Embedded systems",
		"Browser security",
		"Fuzzing",
		"Memory corruption",
		"Web application security",
		"Bug bounty",
	],
	sameAs: socials,
};

const article = publishedDate
	? {
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			headline: title,
			description,
			datePublished: publishedDate.toISOString(),
			inLanguage: lang,
			keywords: tags.join(", "),
			mainEntityOfPage: canonicalURL.href,
			author: { "@type": "Person", name: identity.handle },
		}
	: null;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={identity.handle} />
<meta name="keywords" content={keywords.join(", ")} />
<meta name="robots" content="index, follow, max-image-preview:large" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={`${identity.handle} — ${identity.role}`} />
<meta property="og:locale" content={lang === "es" ? "es_MX" : "en_US"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
{
	publishedDate && (
		<meta
			property="article:published_time"
			content={publishedDate.toISOString()}
		/>
	)
}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:site" content="@c0l1nr00t" />
<meta property="twitter:creator" content="@c0l1nr00t" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- Datos estructurados -->
<script
	type="application/ld+json"
	set:html={JSON.stringify(person)}
	is:inline
/>
{
	article && (
		<script
			type="application/ld+json"
			set:html={JSON.stringify(article)}
			is:inline
		/>
	)
}

<!-- Analytics (Placeholder) -->
<!-- Set PUBLIC_ANALYTICS_ID in .env to enable -->
{
	import.meta.env.PUBLIC_ANALYTICS_ID && (
		<script
			defer
			data-domain={Astro.url.hostname}
			src="https://plausible.io/js/script.js"
		/>
	)
}
<!-- Cloudflare Web Analytics -->
<script
	defer
	src="https://static.cloudflareinsights.com/beacon.min.js"
	data-cf-beacon='{"token": "df75a4f840584e288cf0a3335fcfb691"}'></script>
<!-- End Cloudflare Web Analytics -->

<!-- Sitemap y feed -->
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${identity.handle} — Research Log`}
	href={`/${lang}/rss.xml`}
/>
