---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Motion from "../components/Motion.astro";
import CommandPalette from "../components/CommandPalette.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { ViewTransitions } from "astro:transitions";

interface Props {
    title: string;
    description: string;
    image?: string;
    type?: "website" | "article";
    publishedDate?: Date;
    tags?: string[];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description, image, type, publishedDate, tags } = Astro.props;
---

<!doctype html>
<html lang={lang}>
    <head>
        <BaseHead
            title={title}
            description={description}
            image={image}
            lang={lang}
            type={type}
            publishedDate={publishedDate}
            tags={tags}
        />
        <ViewTransitions />

        {/* Marca que hay JS antes de pintar: sin esto nada se oculta para
            animarse. ViewTransitions reescribe los atributos de <html> en cada
            navegación, así que hay que volver a ponerla tras el swap. */}
        <script is:inline>
            (() => {
                const mark = () => document.documentElement.classList.add("js");
                mark();
                document.addEventListener("astro:after-swap", mark);
            })();
        </script>
    </head>
    <body>
        <a class="skip-link mono" href="#main">Saltar al contenido</a>

        {type === "article" && <div class="read-progress" aria-hidden="true" />}

        <Header />

        <main id="main" class="fade-in">
            <slot />
        </main>

        <Footer />

        <CommandPalette />
        <Motion />

        <a
            href="/files/cv.pdf"
            download
            class="cv-fab mono"
            title={t("cv.download")}
        >
            <span aria-hidden="true">↓</span>
            <span>CV</span>
        </a>
    </body>
</html>

<style>
    main {
        flex: 1;
    }

    .skip-link {
        position: absolute;
        top: var(--sp-2);
        left: var(--sp-2);
        z-index: 200;
        padding: var(--sp-2) var(--sp-4);
        background: var(--surface-2);
        border: 1px solid var(--accent-line);
        border-radius: var(--radius-sm);
        color: var(--accent-strong);
        font-size: var(--fs-sm);
        transform: translateY(-200%);
        transition: transform var(--dur) var(--ease);
    }

    .skip-link:focus-visible {
        transform: none;
    }

    /* Acceso rápido al CV solo en móvil: en escritorio ya está en la cabecera */
    .cv-fab {
        position: fixed;
        right: var(--sp-4);
        bottom: var(--sp-4);
        z-index: 90;
        display: none;
        align-items: center;
        gap: var(--sp-2);
        padding: 0.6rem 0.9rem;
        background: color-mix(in srgb, var(--surface-2) 92%, transparent);
        border: 1px solid var(--accent-line);
        border-radius: var(--radius-pill);
        color: var(--accent-strong);
        font-size: var(--fs-sm);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        box-shadow: var(--shadow);
    }

    .cv-fab:active {
        transform: translateY(1px);
    }

    @media (max-width: 820px) {
        .cv-fab {
            display: inline-flex;
        }
    }
</style>
