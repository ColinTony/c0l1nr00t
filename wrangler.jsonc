{
    "name": "colintony-site",
    "compatibility_date": "2026-01-05",

    // El HTML lo sirve el enrutador de assets; lo que no sea un archivo de
    // dist/ (hoy solo /api/reactions) entra al worker.
    "main": "worker/index.js",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
    },

    // Alta de la base (una sola vez):
    //   npx wrangler d1 create colintony-reactions
    // y pega aquí el database_id que devuelve el comando.
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "colintony-reactions",
            "database_id": "PENDIENTE_PEGAR_ID_DE_wrangler_d1_create",
            "migrations_dir": "migrations"
        }
    ]
}
